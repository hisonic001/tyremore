# ============================================================
#  이 파일을 복사해서 .env.local 로 저장한 뒤 값을 채우세요.
#  .env.local 은 .gitignore 로 막혀 있어 GitHub에 올라가지 않습니다.
# ============================================================

# --- 데이터베이스 -------------------------------------------
# ① 로컬 Docker 를 쓰는 경우
DATABASE_URL="postgres://tyremore:tyremore_local_dev@localhost:5432/tyremore"

# ② Supabase(서울) 를 쓰는 경우 — 프로젝트 설정 > Database > Connection string
#    ⚠️ 반드시 서울 리전(ap-northeast-2). 개인정보 국내 저장 (D-11)
# DATABASE_URL="postgres://postgres.xxxxx:비밀번호@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres"

# --- 이관 원본 데이터 위치 -----------------------------------
# ⭐ 저장소 밖이어야 한다. 개인정보가 GitHub로 나가는 것을 원천 차단한다 (D-13)
IMPORT_DATA_DIR="C:/dev/tyremore-data"

# --- 로그인 -------------------------------------------------
# 세션 쿠키 서명 키. 16자 이상의 임의 문자열.
# ⚠️ 이 값이 새면 남이 로그인 상태를 위조할 수 있습니다. 배포 환경변수에도 같은 값을 넣으세요.
# 만드는 법(PowerShell):
#   -join ((1..48) | ForEach-Object { '{0:x}' -f (Get-Random -Max 16) })
AUTH_SECRET="여기에-임의의-긴-문자열"

# --- 애플리케이션 -------------------------------------------
TZ="Asia/Seoul"
