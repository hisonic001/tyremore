    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "import": "tsx scripts/import/run-all.ts",
    "import:report": "tsx scripts/import/report.ts",
    "collect": "tsx scripts/collect.ts",
    "mars": "tsx scripts/mars-fill.ts",
    "mars:watch": "tsx scripts/mars-watch.ts",
    "blog-draft": "tsx scripts/blog-draft.ts",
    "db:backup": "tsx scripts/backup-db.ts",
    "db:restore": "tsx scripts/restore-db.ts",
    "mars:agent": "tsx scripts/mars-agent.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.122.0",
    "drizzle-orm": "^0.44.0",
    "lucide-react": "^1.34.0",
